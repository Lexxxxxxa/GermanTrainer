<Window x:Class="GermanTrainer.Views.WordsManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛠️ Управление словами"
        Width="600" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <!-- DataContext: WordsManagementViewModel -->
    <Window.Resources>
        <Style x:Key="HiddenAwareWordText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToggleHiddenButton" TargetType="Button" BasedOn="{StaticResource SmallColoredButton}">
            <Setter Property="Background" Value="{StaticResource WrongBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CorrectBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📋 Управление словами" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding EmptyMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding EmptyMessage, Converter={StaticResource NullOrEmptyToVisibility}}"/>

                <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Separator Style="{StaticResource ThemedSeparator}" Margin="0,12,0,8"
                                           Visibility="{Binding IsFirst, Converter={StaticResource InverseBoolToVisibility}}"/>

                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"
                                           Visibility="{Binding Title, Converter={StaticResource NullOrEmptyToVisibility}}"/>

                                <ItemsControl ItemsSource="{Binding Lessons}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}" Margin="0,12,0,6"/>

                                                <ItemsControl ItemsSource="{Binding Words}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SurfaceBrush}"
                                                                    BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1"
                                                                    CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayWord}" Style="{StaticResource HiddenAwareWordText}"/>
                                                                        <TextBlock Text="{Binding Translation}" FontSize="11" Margin="0,4,0,0"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                                                   Visibility="{Binding Translation, Converter={StaticResource NullOrEmptyToVisibility}}"/>
                                                                    </StackPanel>

                                                                    <Button Grid.Column="1" Content="{Binding ToggleHiddenText}"
                                                                            Style="{StaticResource ToggleHiddenButton}" VerticalAlignment="Center"
                                                                            Command="{Binding DataContext.ToggleHiddenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="✓ Готово" Command="{Binding DoneCommand}"
                Style="{StaticResource SmallColoredButton}" Background="{StaticResource CorrectBrush}"
                FontSize="14" Padding="20,10" HorizontalAlignment="Right" Margin="0,10,0,0"/>
    </Grid>
</Window>
