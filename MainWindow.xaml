<Window x:Class="GermanTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GermanTrainer.ViewModels"
        xmlns:views="clr-namespace:GermanTrainer.Views"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MenuViewModel}">
            <views:MenuView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrainerArticlesViewModel}">
            <views:ArticlesTrainerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrainerTranslationViewModel}">
            <views:TranslationTrainerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding CurrentPage}" Focusable="False"/>

        <Button Content="← Меню"
                Command="{Binding BackToMenuCommand}"
                Style="{StaticResource FlatButton}"
                Foreground="{StaticResource AccentBrush}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20"
                Visibility="{Binding IsMenuPage, Converter={StaticResource InverseBoolToVisibility}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20">
            <Button Content="🛠️ Управление"
                    Command="{Binding ManageWordsCommand}"
                    Style="{StaticResource FlatButton}"
                    FontSize="14"
                    Foreground="{StaticResource WarningBrush}"
                    Margin="0,0,10,0"
                    Visibility="{Binding IsTrainerPage, Converter={StaticResource BoolToVisibility}}"/>

            <Button Content="{Binding ThemeIcon}"
                    ToolTip="{Binding ThemeToolTip}"
                    Command="{Binding ToggleThemeCommand}"
                    Style="{StaticResource ThemeToggleButton}"/>
        </StackPanel>
    </Grid>
</Window>
