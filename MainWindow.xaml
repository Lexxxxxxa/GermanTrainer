<Window x:Class="GermanTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🇩🇪 German Trainer" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#1F2121">

    <Grid x:Name="RootGrid" Background="#1F2121">

        <!-- Theme Toggle Button -->
        <Button x:Name="ThemeButton" 
                Content="🌙"
                Click="ToggleTheme_Click"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="20"
                Width="50" 
                Height="50" 
                FontSize="24"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Panel.ZIndex="999"
                ToolTip="Переключить тему">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="25" 
                                        Padding="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Back Button -->
        <Button x:Name="BackButton" 
                Content="← Меню"
                Click="BackToMenu_Click"
                HorizontalAlignment="Left" 
                VerticalAlignment="Top" 
                Padding="15,10"
                FontSize="16"
                FontWeight="SemiBold"
                Margin="20"
                Panel.ZIndex="998"
                Background="Transparent"
                Foreground="#32B6C6"
                BorderThickness="0"
                Cursor="Hand"
                Visibility="Collapsed">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Manage Words Button (Articles) -->
        <Button x:Name="ManageWordsButtonArticles" 
                Content="🛠️ Управление"
                Click="ManageWordsButton_Click"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Padding="15,10"
                FontSize="14"
                FontWeight="SemiBold"
                Margin="20,20,80,20"
                Panel.ZIndex="997"
                Background="Transparent"
                Foreground="#FF9800"
                BorderThickness="0"
                Cursor="Hand"
                Visibility="Collapsed">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Manage Words Button (Translation) -->
        <Button x:Name="ManageWordsButtonTranslation" 
                Content="🛠️ Управление"
                Click="ManageWordsButton_Click"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Padding="15,10"
                FontSize="14"
                FontWeight="SemiBold"
                Margin="20,20,80,20"
                Panel.ZIndex="997"
                Background="Transparent"
                Foreground="#FF9800"
                BorderThickness="0"
                Cursor="Hand"
                Visibility="Collapsed">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Check Answer Button (Articles Mode) -->
        <Button x:Name="CheckAnswerButtonArticles" 
                Content="✓ Проверить"
                Click="CheckAnswer_Click"
                Width="250" 
                Height="70" 
                FontSize="24"
                FontWeight="Bold"
                Background="#4CAF50"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom" 
                Margin="0,0,0,30"
                Panel.ZIndex="100"
                Visibility="Collapsed">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Check Answer Button (Translation Mode) -->
        <Button x:Name="CheckAnswerButtonTranslation" 
                Content="✓ Проверить"
                Click="CheckAnswer_Click"
                Width="250" 
                Height="70" 
                FontSize="24"
                FontWeight="Bold"
                Background="#2196F3"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom" 
                Margin="0,0,0,30"
                Panel.ZIndex="100"
                Visibility="Collapsed">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- MENU PAGE -->
        <Grid x:Name="MenuPage" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="MenuHeaderBorder" Grid.Row="0" Background="#262828" Padding="40,30">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="MenuTitle" Text="🇩🇪 Тренер немецкого языка" 
                               FontSize="36" FontWeight="Bold" Foreground="#F5F5F5" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MenuSubtitle" Text="Выберите режим тренировки" 
                               FontSize="18" Foreground="#A7A9A9" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="60,40" MaxWidth="900">
                    <!-- Articles Mode Card -->
                    <Border Tag="Card" Background="#262828" CornerRadius="12" Padding="30" 
                            Margin="0,0,0,20" Cursor="Hand" MouseLeftButtonDown="ArticleMode_Click">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#2196F3" CornerRadius="10" Width="70" Height="70" Margin="0,0,25,0">
                                <TextBlock Text="📘" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Tag="CardTitle" Text="Выбор артикля" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5"/>
                                <TextBlock Tag="CardSubtitle" Text="Определи правильный артикль (der, die, das)" FontSize="14" Foreground="#A7A9A9" 
                                           Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="→" FontSize="32" Foreground="#2196F3" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Translation Mode Card -->
                    <Border Tag="Card" Background="#262828" CornerRadius="12" Padding="30" 
                            Margin="0,0,0,20" Cursor="Hand" MouseLeftButtonDown="TranslationMode_Click">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#4CAF50" CornerRadius="10" Width="70" Height="70" Margin="0,0,25,0">
                                <TextBlock Text="💬" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Tag="CardTitle" Text="Выбор перевода" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5"/>
                                <TextBlock Tag="CardSubtitle" Text="Найди правильный перевод слова" FontSize="14" Foreground="#A7A9A9" 
                                           Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="→" FontSize="32" Foreground="#4CAF50" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Plural Mode Card -->
                    <Border Tag="Card" Background="#262828" CornerRadius="12" Padding="30" 
                            Margin="0,0,0,20" Cursor="Hand" MouseLeftButtonDown="PluralMode_Click">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#9C27B0" CornerRadius="10" Width="70" Height="70" Margin="0,0,25,0">
                                <TextBlock Text="📝" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Tag="CardTitle" Text="Множественное число" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5"/>
                                <TextBlock Tag="CardSubtitle" Text="Тренировка множественного числа (Plural)" FontSize="14" Foreground="#A7A9A9" 
                                           Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="→" FontSize="32" Foreground="#9C27B0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Settings Card -->
                    <Border Tag="Card" Background="#262828" CornerRadius="12" Padding="30" 
                            Cursor="Hand" MouseLeftButtonDown="Settings_Click">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#FF9800" CornerRadius="10" Width="70" Height="70" Margin="0,0,25,0">
                                <TextBlock Text="⚙️" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Tag="CardTitle" Text="⚙️ Настройки" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5"/>
                                <TextBlock Tag="CardSubtitle" Text="Выбери уроки, управляй словами, скрывай слова" FontSize="14" Foreground="#A7A9A9" 
                                           Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="→" FontSize="32" Foreground="#FF9800" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ARTICLES PAGE -->
        <Grid x:Name="ArticlePage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="ArticleHeader" Grid.Row="0" Background="#262828" Padding="30,20" Margin="0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border x:Name="ArticleCorrectBadge" Background="#4CAF50" CornerRadius="8" Padding="15,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓ " FontSize="18" Foreground="White" FontWeight="Bold"/>
                            <TextBlock x:Name="CorrectCount" Text="{Binding CorrectCount}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ArticleWrongBadge" Background="#F44336" CornerRadius="8" Padding="15,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✗ " FontSize="18" Foreground="White" FontWeight="Bold"/>
                            <TextBlock x:Name="WrongCount" Text="{Binding WrongCount}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ArticlePercentBadge" Background="#2196F3" CornerRadius="8" Padding="15,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊 " FontSize="18"/>
                            <TextBlock x:Name="SuccessPercentage" Text="{Binding SuccessPercentage}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="60">
                    <TextBlock x:Name="ArticleQuestionText" Text="Какой артикль?" FontSize="32" FontWeight="SemiBold" 
                               Foreground="#F5F5F5" Margin="0,0,0,50" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ArticleWordDisplay" Text="{Binding CurrentNounDisplay}" FontSize="72" FontWeight="Bold" 
                               Foreground="#32B6C6" HorizontalAlignment="Center" Margin="0,0,0,80"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,50">
                        <Button x:Name="BtnDer" Content="der" Click="ButtonClick_der"
                                Width="140" Height="90" FontSize="32" FontWeight="Bold" 
                                Margin="0,0,20,0" Background="#2196F3" Foreground="White" 
                                BorderThickness="5" BorderBrush="Transparent" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="12" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="BtnDie" Content="die" Click="ButtonClick_die"
                                Width="140" Height="90" FontSize="32" FontWeight="Bold" 
                                Margin="0,0,20,0" Background="#E91E63" Foreground="White" 
                                BorderThickness="5" BorderBrush="Transparent" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="12" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="BtnDas" Content="das" Click="ButtonClick_das"
                                Width="140" Height="90" FontSize="32" FontWeight="Bold" 
                                Background="#9C27B0" Foreground="White" 
                                BorderThickness="5" BorderBrush="Transparent" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="12" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="ArticleFeedbackText" Text="{Binding Feedback}" FontSize="24" Foreground="#F5F5F5" 
                               Margin="0,0,0,30" TextWrapping="Wrap" HorizontalAlignment="Center" FontWeight="Medium" MaxWidth="800" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- SETTINGS/TRANSLATION PAGE -->
        <Grid x:Name="SettingsPage" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="SettingsHeader" Grid.Row="0" Background="#262828" Padding="40,30">
                <TextBlock x:Name="SettingsTitle" Text="⚙️ Настройки" FontSize="28" FontWeight="Bold" 
                           Foreground="#F5F5F5" HorizontalAlignment="Center"/>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SettingsContentPanel" Margin="60,20"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
