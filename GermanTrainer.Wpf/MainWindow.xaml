<Window x:Class="GermanTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GermanTrainer.ViewModels"
        xmlns:views="clr-namespace:GermanTrainer.Views"
        Title="German Trainer" Width="1200" Height="800"
        MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MenuViewModel}">
            <views:MenuView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrainerArticlesViewModel}">
            <views:ArticlesTrainerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrainerTranslationViewModel}">
            <views:TranslationTrainerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TrainerPrepositionsViewModel}">
            <views:PrepositionsTrainerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VocabularyViewModel}">
            <views:VocabularyView/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- A separate toolbar row prevents buttons from covering page headings. -->
        <Grid Margin="20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="← Меню" Command="{Binding BackToMenuCommand}" Style="{StaticResource FlatButton}"
                    Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Visibility="{Binding IsMenuPage, Converter={StaticResource InverseBoolToVisibility}}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Словарь" Command="{Binding OpenVocabularyCommand}" Style="{StaticResource FlatButton}"
                        Foreground="{StaticResource AccentBrush}" FontSize="14" Margin="0,0,10,0"/>
                <Button Content="Управление словами" Command="{Binding ManageWordsCommand}" Style="{StaticResource FlatButton}"
                        Foreground="{StaticResource WarningBrush}" FontSize="14" Margin="0,0,10,0"
                        Visibility="{Binding IsTrainerPage, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="{Binding ThemeIcon}" ToolTip="{Binding ThemeToolTip}" Command="{Binding ToggleThemeCommand}" Style="{StaticResource ThemeToggleButton}"/>
            </StackPanel>
        </Grid>
        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False"/>
    </Grid>
</Window>
