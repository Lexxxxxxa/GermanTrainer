<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Dark Theme -->
    <sys:Boolean x:Key="IsThemeDictionary">True</sys:Boolean>

    <SolidColorBrush x:Key="BackgroundBrush" Color="#1F2121"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#262828"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B3A7A9A9"/>
    <SolidColorBrush x:Key="BorderLineBrush" Color="#4C777C7C"/>
</ResourceDictionary>
