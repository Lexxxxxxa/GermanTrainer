<UserControl x:Class="GermanTrainer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: SettingsViewModel -->
    <UserControl.Resources>
        <!-- Word card: [article] word | translation | correct/incorrect -->
        <DataTemplate x:Key="WordCardTemplate">
            <Border Style="{StaticResource WordCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="70"
                            Visibility="{Binding HasArticle, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="{Binding Article, Converter={StaticResource ArticleToBrush}}"
                                CornerRadius="4" Padding="6" Margin="6" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Article}" FontSize="11" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Border>

                    <TextBlock Grid.Column="1" Text="{Binding Word}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Padding="8,0,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Word}"/>

                    <TextBlock Grid.Column="2" Text="{Binding Translation}" FontSize="12"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Padding="8,0,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Translation}"/>

                    <TextBlock Grid.Column="3" Text="{Binding StatsText}" FontSize="10" ToolTip="Верно / Неверно"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Padding="4,0,0,0"/>

                    <Button Grid.Column="4" Content="❌" ToolTip="Удалить слово" Style="{StaticResource IconButton}"
                            Command="{Binding DataContext.DeleteWordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBorder}" Padding="40,30">
            <TextBlock Text="⚙️ Настройки и управление словами" Style="{StaticResource PageTitleText}"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="60,20">

                <!-- ===== Choosing lessons and word types ===== -->
                <Border Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Text="📚 Выбор уроков и типов слов для тренировки" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Text="Выберите какие уроки и типы слов использовать в тренировке."
                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,20"/>

                        <TextBlock Text="📝 Типы слов:" Style="{StaticResource SubsectionTitleText}"/>
                        <ItemsControl ItemsSource="{Binding WordTypes}" Focusable="False" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                              Style="{StaticResource ThemedCheckBox}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="{DynamicResource BorderLineBrush}" Margin="0,20"/>

                        <TextBlock Text="📖 Уроки:" Style="{StaticResource SubsectionTitleText}"/>
                        <ItemsControl ItemsSource="{Binding Lessons}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                              Style="{StaticResource ThemedCheckBox}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="💾 Сохранить" Command="{Binding SaveCommand}"
                                Style="{StaticResource SmallColoredButton}" Background="{StaticResource CorrectBrush}"
                                FontSize="16" Padding="20" Margin="0,20,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Separator Style="{StaticResource ThemedSeparator}" Margin="0,10,0,30"/>

                <!-- ===== Word Management ===== -->
                <Border Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Text="🛠️ Управление словами" Style="{StaticResource SectionTitleText}"/>

                        <ItemsControl ItemsSource="{Binding LessonGroups}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="20"
                                            Margin="0,0,0,20" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,20"/>

                                            <ItemsControl ItemsSource="{Binding TypeGroups}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <Separator Style="{StaticResource ThemedSeparator}"
                                                                       Visibility="{Binding IsFirst, Converter={StaticResource InverseBoolToVisibility}}"/>
                                                            <Expander Header="{Binding Header}" Style="{StaticResource ThemedExpander}">
                                                                <ItemsControl ItemsSource="{Binding Words}" Margin="0,10,0,0"
                                                                              ItemTemplate="{StaticResource WordCardTemplate}"
                                                                              FontWeight="Normal" Focusable="False"/>
                                                            </Expander>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
