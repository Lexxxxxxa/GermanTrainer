<UserControl x:Class="GermanTrainer.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource HeaderBorder}" Padding="40,24">
            <StackPanel>
                <TextBlock Text="Настройки тренировки" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="Выберите уровни, модули и типы слов." Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,20" MaxWidth="1100">
                <Border Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Text="Типы слов" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Text="Этот выбор относится к переводам. Артикли используют существительные, предлоги используют глаголы."
                                   TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding WordTypes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,0,24,8"
                                              Style="{StaticResource ThemedCheckBox}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SurfaceCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Уровни и модули" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Text="У каждого уровня свой набор модулей. Можно тренировать несколько уровней одновременно."
                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12">
                            <Button Content="Выбрать всё" Command="{Binding SelectAllCommand}" Style="{StaticResource FlatButton}"
                                    Foreground="{DynamicResource AccentBrush}" Margin="0,0,20,0"/>
                            <Button Content="Снять выбор" Command="{Binding ClearCommand}" Style="{StaticResource FlatButton}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Levels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderLineBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                        <Expander Header="{Binding Header}" IsExpanded="True" Style="{StaticResource ThemedExpander}">
                                            <StackPanel Margin="0,12,0,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Button Content="Все модули уровня" Command="{Binding SelectAllCommand}"
                                                            Style="{StaticResource FlatButton}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,20,0"/>
                                                    <Button Content="Снять выбор" Command="{Binding ClearCommand}"
                                                            Style="{StaticResource FlatButton}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Modules}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Width="250" Content="{Binding Label}" IsChecked="{Binding IsChecked}"
                                                                      Style="{StaticResource ThemedCheckBox}" Margin="0,0,12,10"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderLineBrush}"
                BorderThickness="0,1,0,0" Padding="40,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{Binding SelectionSummary}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Сохранить настройки" Command="{Binding SaveCommand}"
                        Style="{StaticResource SmallColoredButton}" Background="{DynamicResource CorrectBrush}" Padding="20,12"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
