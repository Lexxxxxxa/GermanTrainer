<UserControl x:Class="GermanTrainer.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: MenuViewModel -->
    <UserControl.Resources>
        <Style x:Key="MenuIconBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="0,0,25,0"/>
        </Style>
        <Style x:Key="MenuCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBorder}" Padding="40,30">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🇩🇪 Тренер немецкого языка" FontSize="36" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Выберите режим тренировки" FontSize="18"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="60,40" MaxWidth="900">
                <!-- Articles Trainer -->
                <Button Style="{StaticResource MenuCardButton}" Command="{Binding OpenArticlesCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#2196F3" Style="{StaticResource MenuIconBorder}">
                            <TextBlock Text="📘" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Выбор артикля" Style="{StaticResource MenuCardTitle}"/>
                            <TextBlock Text="Определи правильный артикль (der, die, das)" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="→" FontSize="32" Foreground="#2196F3" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <!-- Translation Trainer -->
                <Button Style="{StaticResource MenuCardButton}" Command="{Binding OpenTranslationCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#4CAF50" Style="{StaticResource MenuIconBorder}">
                            <TextBlock Text="💬" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Выбор перевода" Style="{StaticResource MenuCardTitle}"/>
                            <TextBlock Text="Найди правильный перевод слова" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="→" FontSize="32" Foreground="#4CAF50" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <!-- Verbs with prepositions -->
                <Button Style="{StaticResource MenuCardButton}" Command="{Binding OpenPrepositionsCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#9C27B0" Style="{StaticResource MenuIconBorder}">
                            <TextBlock Text="📝" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Глаголы с предлогами" Style="{StaticResource MenuCardTitle}"/>
                            <TextBlock Text="Выбери предлог и падеж: Akkusativ или Dativ" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="→" FontSize="32" Foreground="#9C27B0" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
                <!-- Settings -->
                <Button Style="{StaticResource MenuCardButton}" Command="{Binding OpenSettingsCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#FF9800" Style="{StaticResource MenuIconBorder}">
                            <TextBlock Text="⚙️" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="⚙️ Настройки" Style="{StaticResource MenuCardTitle}"/>
                            <TextBlock Text="Выбери уроки, управляй словами, скрывай слова" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="→" FontSize="32" Foreground="#FF9800" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
