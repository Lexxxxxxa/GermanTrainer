<UserControl x:Class="GermanTrainer.Wpf.Views.ArticlesTrainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GermanTrainer.Wpf.Views">
    <!-- DataContext: TrainerArticlesViewModel -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:SessionStatsBar Grid.Row="0"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,25">
                <TextBlock Text="Какой артикль?" FontSize="32" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="{Binding CurrentNounDisplay}" FontSize="56" FontWeight="Bold"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="780"
                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- Button der/die/das -->
                <ItemsControl ItemsSource="{Binding ArticleOptions}" HorizontalAlignment="Center" Margin="0,0,0,50"
                          Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Article}"
                                Background="{Binding Article, Converter={StaticResource ArticleToBrush}}"
                                Command="{Binding DataContext.SelectArticleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Article}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ArticleButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Feedback}" FontSize="24" FontWeight="Medium"
                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" MaxWidth="800" Margin="0,0,0,30"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Check/Next -->
        <Button Grid.Row="2"
                Content="{Binding ActionButtonText}"
                ToolTip="{Binding ActionButtonToolTip}"
                Command="{Binding CheckOrNextCommand}"
                Style="{StaticResource PrimaryActionButton}"
                Background="{StaticResource CorrectBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30"/>
    </Grid>
</UserControl>
