<UserControl x:Class="GermanTrainer.Views.ArticlesTrainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GermanTrainer.Views">
    <!-- DataContext: TrainerArticlesViewModel -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:SessionStatsBar Grid.Row="0"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="60,60,60,130">
            <TextBlock Text="Какой артикль?" FontSize="32" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,50"/>

            <TextBlock Text="{Binding CurrentNounDisplay}" FontSize="72" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,80"/>

            <!-- Button der/die/das -->
            <ItemsControl ItemsSource="{Binding ArticleOptions}" HorizontalAlignment="Center" Margin="0,0,0,50"
                          Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Article}"
                                Background="{Binding Article, Converter={StaticResource ArticleToBrush}}"
                                Command="{Binding DataContext.SelectArticleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Article}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ArticleButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Feedback}" FontSize="24" FontWeight="Medium"
                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" MaxWidth="800" Margin="0,0,0,30"/>
        </StackPanel>

        <!-- Check/Next -->
        <Button Grid.Row="1"
                Content="{Binding ActionButtonText}"
                ToolTip="{Binding ActionButtonToolTip}"
                Command="{Binding CheckOrNextCommand}"
                Style="{StaticResource PrimaryActionButton}"
                Background="{StaticResource CorrectBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30"/>
    </Grid>
</UserControl>
