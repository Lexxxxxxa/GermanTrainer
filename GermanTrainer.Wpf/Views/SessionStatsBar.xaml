<UserControl x:Class="GermanTrainer.Views.SessionStatsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource HeaderBorder}" Padding="30,80,30,12">
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Border Style="{StaticResource Badge}" Background="{StaticResource CorrectBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓ " Style="{StaticResource BadgeText}"/>
                    <TextBlock Text="{Binding CorrectCount}" Style="{StaticResource BadgeText}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Badge}" Background="{StaticResource WrongBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✗ " Style="{StaticResource BadgeText}"/>
                    <TextBlock Text="{Binding WrongCount}" Style="{StaticResource BadgeText}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Badge}" Background="{StaticResource PercentBrush}" Margin="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📊 " FontSize="18"/>
                    <TextBlock Text="{Binding SuccessPercentage}" Style="{StaticResource BadgeText}"/>
                </StackPanel>
            </Border>
            <Button Content="Сбросить статистику"
                    Command="{Binding ResetStatisticsCommand}"
                    ToolTip="Сбросить только счётчики текущей сессии"
                    Style="{StaticResource SmallColoredButton}"
                    Background="{StaticResource WarningBrush}" FontSize="13"
                    Padding="12,8" Margin="15,0,0,0" VerticalAlignment="Center"/>
        </WrapPanel>
    </Border>
</UserControl>
