<UserControl x:Class="GermanTrainer.Wpf.Views.VocabularyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Editor-only styles use the existing application's colours. -->
        <Style x:Key="CompactActionButton" TargetType="Button" BasedOn="{StaticResource SmallColoredButton}">
            <Setter Property="Background" Value="{StaticResource PercentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLineBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Padding" Value="8,10"/>
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    </UserControl.InputBindings>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16" IsEnabled="{Binding IsIdle}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}"/>
            <TextBlock Text="{Binding ContextHint}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <WrapPanel>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="350" Margin="0,0,12,8"
                         ToolTip="Поиск по слову, переводу, уровню, модулю, предлогу, падежу и подсказке"/>
                <Button Content="Сбросить фильтры" Command="{Binding ResetFiltersCommand}" Style="{StaticResource FlatButton}" Margin="0,0,12,8"/>
                <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource FlatButton}" Margin="0,0,0,8"/>
            </WrapPanel>
            <WrapPanel>
                <StackPanel Width="135" Margin="0,0,10,8">
                    <TextBlock Text="Уровень" Style="{StaticResource SecondaryText}"/>
                    <ComboBox ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding LevelFilter}"/>
                </StackPanel>
                <StackPanel Width="125" Margin="0,0,10,8">
                    <TextBlock Text="Модуль" Style="{StaticResource SecondaryText}"/>
                    <ComboBox ItemsSource="{Binding LessonOptions}" SelectedItem="{Binding LessonFilter}"/>
                </StackPanel>
                <StackPanel Width="165" Margin="0,0,10,8">
                    <TextBlock Text="Часть речи" Style="{StaticResource SecondaryText}"/>
                    <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding TypeFilter}"/>
                </StackPanel>
                <StackPanel Width="130" Margin="0,0,10,8">
                    <TextBlock Text="Артикль" Style="{StaticResource SecondaryText}"/>
                    <ComboBox ItemsSource="{Binding ArticleOptions}" SelectedItem="{Binding ArticleFilter}"/>
                </StackPanel>
                <StackPanel Width="135" Margin="0,0,10,8">
                    <TextBlock Text="В тренировке" Style="{StaticResource SecondaryText}"/>
                    <ComboBox ItemsSource="{Binding VisibilityOptions}" SelectedItem="{Binding VisibilityFilter}"/>
                </StackPanel>
                <StackPanel Width="170" Margin="0,0,0,8">
                    <TextBlock Text="Конструкции глагола" Style="{StaticResource SecondaryText}"/>
                    <ComboBox ItemsSource="{Binding ConstructionOptions}" SelectedItem="{Binding ConstructionFilter}"/>
                </StackPanel>
            </WrapPanel>
            <CheckBox Content="Только модули, выбранные в настройках" IsChecked="{Binding OnlySelectedModules}"
                      Style="{StaticResource ThemedCheckBox}"/>
        </StackPanel>
        <Grid Grid.Row="1" IsEnabled="{Binding IsIdle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Words}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Слово" Binding="{Binding Word}" Width="*" MinWidth="110"/>
                    <DataGridTextColumn Header="Перевод" Binding="{Binding Translation}" Width="*" MinWidth="140"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding TypeLabel}" Width="110"/>
                    <DataGridTextColumn Header="Модуль" Binding="{Binding Lesson}" Width="60"/>
                    <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="65"/>
                    <DataGridCheckBoxColumn Header="Скрыто" Binding="{Binding IsHidden}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="22" Margin="0" IsEnabled="{Binding HasSelection}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Редактор записи" Style="{StaticResource SectionTitleText}"/>
                        <TextBlock Text="Тип" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding TypeLabel}" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0">
                            <Run Text="Верно: "/><Run Text="{Binding Selected.CorrectAnswers, Mode=OneWay}"/>
                            <Run Text=" · Ошибки: "/><Run Text="{Binding Selected.WrongAnswers, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="Немецкое слово" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Draft.Word, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/>
                        <TextBlock Text="Перевод / значения" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Draft.Translation, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Модуль" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding LessonText, UpdateSourceTrigger=PropertyChanged}" MaxLength="3"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Уровень (необязательно)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Draft.Level, UpdateSourceTrigger=PropertyChanged}" MaxLength="2"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Visibility="{Binding IsNoun, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Артикль" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Draft.Article, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"/>
                            <TextBlock Text="Множественное число (справочное поле)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Draft.PluralForm, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/>
                        </StackPanel>
                        <CheckBox Content="Скрыть из тренировок" IsChecked="{Binding Draft.IsHidden}" Style="{StaticResource ThemedCheckBox}" Margin="0,20,0,10"/>
                        <StackPanel Visibility="{Binding IsVerb, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Предлоги и падежи" Style="{StaticResource SubsectionTitleText}" Margin="0,18,0,8"/>
                            <TextBlock Text="Одна строка = одна конструкция. Форма глагола без предлога; подсказка различает значения." Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,0,0,12"/>
                            <DataGrid ItemsSource="{Binding Constructions}" SelectedItem="{Binding SelectedConstruction}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="120">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Форма" Binding="{Binding VerbDisplay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="Подсказка" Binding="{Binding Meaning, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridComboBoxColumn Header="Предлог" SelectedItemBinding="{Binding Preposition}" Width="70">
                                        <DataGridComboBoxColumn.ElementStyle>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="ItemsSource" Value="{Binding DataContext.Prepositions, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </Style>
                                        </DataGridComboBoxColumn.ElementStyle>
                                        <DataGridComboBoxColumn.EditingElementStyle>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="ItemsSource" Value="{Binding DataContext.Prepositions, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </Style>
                                        </DataGridComboBoxColumn.EditingElementStyle>
                                    </DataGridComboBoxColumn>
                                    <DataGridComboBoxColumn Header="Падеж" SelectedItemBinding="{Binding Case}" Width="95">
                                        <DataGridComboBoxColumn.ElementStyle>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="ItemsSource" Value="{Binding DataContext.Cases, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </Style>
                                        </DataGridComboBoxColumn.ElementStyle>
                                        <DataGridComboBoxColumn.EditingElementStyle>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="ItemsSource" Value="{Binding DataContext.Cases, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </Style>
                                        </DataGridComboBoxColumn.EditingElementStyle>
                                    </DataGridComboBoxColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="+ Конструкция" Command="{Binding AddConstructionCommand}" Style="{StaticResource FlatButton}"/>
                                <Button Content="Удалить строку" Command="{Binding RemoveConstructionCommand}" Style="{StaticResource FlatButton}"/>
                            </WrapPanel>
                        </StackPanel>
                        <WrapPanel Margin="0,24,0,0">
                            <Button Content="Сохранить · Ctrl+S" Command="{Binding SaveCommand}" Style="{StaticResource CompactActionButton}" Margin="0,0,12,0"/>
                            <Button Content="Удалить слово" Command="{Binding DeleteCommand}" Style="{StaticResource FlatButton}" Foreground="{StaticResource WrongBrush}"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
