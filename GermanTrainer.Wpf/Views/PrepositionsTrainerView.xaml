<UserControl x:Class="GermanTrainer.Wpf.Views.PrepositionsTrainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GermanTrainer.Wpf.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <views:SessionStatsBar/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource SurfaceCard}" MaxWidth="1000" Margin="40,20">
                <StackPanel>
                    <TextBlock Text="Глаголы с предлогами" Style="{StaticResource PageTitleText}" FontSize="24"/>
                    <TextBlock Text="{Binding CurrentVerbDisplay}" FontSize="52" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,20,0,10"/>
                    <TextBlock Text="{Binding Meaning}" Style="{StaticResource SecondaryText}" FontSize="18"
                               TextAlignment="Center" Margin="0,0,0,25"/>
                    <TextBlock Text="Выбери предлог" Style="{StaticResource SubsectionTitleText}"/>
                    <ItemsControl ItemsSource="{Binding PrepositionOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AnswerOptionButton}" Content="{Binding Text}" Height="55" Padding="10"
                                        Command="{Binding DataContext.SelectPrepositionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Выбери падеж" Style="{StaticResource SubsectionTitleText}" Margin="0,20,0,5"/>
                    <ItemsControl ItemsSource="{Binding CaseOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AnswerOptionButton}" Content="{Binding Text}" Height="60" Padding="10"
                                        Command="{Binding DataContext.SelectCaseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Feedback}" FontSize="20" Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <Button Grid.Row="2" Content="{Binding ActionButtonText}" Command="{Binding CheckOrNextCommand}"
                Style="{StaticResource PrimaryActionButton}" Background="{StaticResource PurpleBrush}"
                HorizontalAlignment="Center" Margin="0,10,0,20"/>
    </Grid>
</UserControl>
